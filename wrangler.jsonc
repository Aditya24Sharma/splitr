{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitr",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat fills process.env from the Worker's secrets
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // The React app is static files; any other path is a page route
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker. Pages and assets are served without it,
    // so they cost no Worker time or requests.
    "run_worker_first": ["/api/*"]
  },
  // The app is only reachable at its own domain, where Cloudflare Access asks
  // for a login. The default *.workers.dev and preview addresses would skip
  // that login, so they stay off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "money.aditya24sharma.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitr",
      "database_id": "8dca0d2b-ce1b-4a48-99b8-c037737cd0d9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
