generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ExpenseType {
  ITEMIZED
  SIMPLE
}

enum SplitMethod {
  EVEN
  EXACT
  ITEMIZED
}

model Person {
  id        String   @id @default(cuid())
  name      String
  colorHex  String   @default("#64748b")
  isDefault Boolean  @default(false)
  // The person who owns the linked bank accounts; at most one
  isMe      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  paidExpenses    Expense[]            @relation("payer")
  itemAssignments ItemAssignment[]
  participations  ExpenseParticipant[]
}

model Expense {
  id                  String      @id @default(cuid())
  type                ExpenseType
  description         String      @default("")
  store               String?
  purchasedAt         DateTime?
  payerId             String
  payer               Person      @relation("payer", fields: [payerId], references: [id])
  subtotalCents       Int         @default(0)
  taxCents            Int         @default(0)
  totalCents          Int
  splitMethod         SplitMethod
  loggedToSplitwise   Boolean     @default(false)
  imagePath           String?
  createdAt           DateTime    @default(now())
  // The bank or hand-added transaction this split was made from, if any
  transactionId       Int?         @unique
  transaction         Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  items        Item[]
  participants ExpenseParticipant[]
  tags         Tag[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Item {
  id             String  @id @default(cuid())
  expenseId      String
  expense        Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  rawName        String?
  name           String
  quantity       Float   @default(1)
  unitPriceCents Int
  lineTotalCents Int
  sortOrder      Int

  assignments ItemAssignment[]
}

model ItemAssignment {
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([itemId, personId])
}

model ExpenseParticipant {
  expenseId        String
  expense          Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  personId         String
  person           Person  @relation(fields: [personId], references: [id])
  exactAmountCents Int?

  @@id([expenseId, personId])
}

// ---------------------------------------------------------------------------
// Money: linked banks and spending
// ---------------------------------------------------------------------------

enum TransactionSource {
  PLAID
  MANUAL
}

model PlaidItem {
  id               Int       @id @default(autoincrement())
  itemId           String    @unique
  accessToken      String
  institutionId    String?
  institutionName  String?
  institutionLogo  String?
  institutionColor String?
  cursor           String?
  createdAt        DateTime  @default(now())

  accounts Account[]
}

model Account {
  id               Int      @id @default(autoincrement())
  plaidAccountId   String   @unique
  itemId           Int
  item             PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name             String
  officialName     String?
  mask             String?
  type             String
  subtype          String?
  // Integer cents
  currentBalance   Int?
  availableBalance Int?
  isoCurrencyCode  String   @default("USD")
  updatedAt        DateTime @default(now())

  transactions Transaction[]
  snapshots    BalanceSnapshot[]
}

model Transaction {
  id                 Int               @id @default(autoincrement())
  source             TransactionSource @default(PLAID)
  plaidTransactionId String?           @unique
  // Null for hand-added (cash) transactions
  accountId          Int?
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD, the local calendar day
  date               String
  // Integer cents, Plaid's sign: positive = money out, negative = money in
  amount             Int
  name               String
  merchantName       String?
  categoryPrimary    String?
  categoryDetailed   String?
  // Your pick, which wins over the bank's category; sync never touches it
  userCategory       String?
  pending            Boolean           @default(false)
  isoCurrencyCode    String            @default("USD")
  createdAt          DateTime          @default(now())

  expense Expense?

  @@index([date])
  @@index([accountId])
}

// One row per account per local day, written at each sync. Net-worth history
// comes from these; it only exists from the day snapshots started.
model BalanceSnapshot {
  id               Int     @id @default(autoincrement())
  accountId        Int
  account          Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date             String
  currentBalance   Int?
  availableBalance Int?

  @@unique([accountId, date])
  @@index([date])
}
